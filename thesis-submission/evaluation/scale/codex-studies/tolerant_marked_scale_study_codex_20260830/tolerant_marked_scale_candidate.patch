 _assignments_lock = threading.Lock()
 
 # Participant-authored visual scale uses one reserved terminal suffix:
-#   <meaning>, scale <tiny|miniature|small|big|large|huge>
+#   <meaning> [,] scale <tiny|miniature|small|big|large|huge>
